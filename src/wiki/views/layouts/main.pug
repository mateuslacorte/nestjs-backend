              p(class="text-xs text-gray-500")= t('brand.docs')

          .flex.flex-row.gap-2.mt-4(role="group" aria-label=t('lang.switchTo'))
            each loc in locales
              a(
                href=loc.href
                class=`flex items-center gap-1 px-2 py-1 rounded text-xs border transition-colors ${loc.active ? 'ring-2 ring-indigo-500 border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-gray-200 text-gray-600 hover:border-gray-300 hover:bg-gray-50'}`
                aria-current=loc.active ? 'true' : false
                title=loc.label
              )
                span= loc.flag
                span= loc.short
        
        nav(class="p-4")
