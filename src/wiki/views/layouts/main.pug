            a(href=wikiPath('/architecture') class=`sidebar-link block px-3 py-2 text-sm text-gray-700 border-l-2 border-transparent rounded-r ${currentPage === 'architecture' ? 'active' : ''}`)
              span= t('nav.architecture')

          .mb-6
