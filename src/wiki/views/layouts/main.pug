            .w-10.h-10.bg-gradient-to-br.from-indigo-500.to-purple-600.rounded-xl.flex.items-center.justify-center
              img(src="/static/nestjs.svg" alt="" class="w-6 h-6 mx-auto" aria-hidden="true")
            div
