extends ../layouts/main

block content
  .mb-12
    .inline-flex.items-center.gap-2.px-3.py-1.bg-indigo-50.rounded-full.text-indigo-700.text-sm.font-medium.mb-4
      svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z")
      span= t('authActiveDirectory.badge')
    h1(class="text-4xl font-bold text-gray-900 mb-4")
      | #{t('authActiveDirectory.hero.titlePrefix')}
      span.gradient-text= t('authActiveDirectory.hero.titleHighlight')
    p(class="text-xl text-gray-600 max-w-3xl")
      = t('authActiveDirectory.hero.subtitle')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectory.overview.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('authActiveDirectory.overview.description')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectory.api.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")= t('authActiveDirectory.api.description')
      .code-block
        .code-header
          span= t('authActiveDirectory.api.codeHeader.label')
          span= t('authActiveDirectory.api.codeHeader.context')
        .code-content
          pre.
            POST #{apiBasePath}/auth/ad/login
            Content-Type: application/json

            {
              "username": "jdoe",
              "password": "StrongP@ssw0rd123"
            }

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectory.transport.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('authActiveDirectory.transport.description')
      .flex.flex-wrap.gap-3
        a(href=wikiPath('/auth/active-directory/ldap') class="inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700")
          = t('authActiveDirectory.transport.ctaLdap')
        a(href=wikiPath('/auth/active-directory/ldaps') class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-indigo-200 text-indigo-700 text-sm font-medium hover:bg-indigo-50")
          = t('authActiveDirectory.transport.ctaLdaps')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectory.userModel.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-0")
        != t('authActiveDirectory.userModel.description')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectory.roles.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('authActiveDirectory.roles.description')
      .code-block
        .code-header
          span= t('authActiveDirectory.roles.exampleLabel')
          span AD_LDAP_GROUP_ROLE_MAP
        .code-content
          pre= t('authActiveDirectory.roles.example')
