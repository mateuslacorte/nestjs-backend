extends ../layouts/main

block content
  .mb-12
    .inline-flex.items-center.gap-2.px-3.py-1.bg-indigo-50.rounded-full.text-indigo-700.text-sm.font-medium.mb-4
      span= t('authActiveDirectoryLdaps.badge')
    h1(class="text-4xl font-bold text-gray-900 mb-4")
      | #{t('authActiveDirectoryLdaps.hero.titlePrefix')}
      span.gradient-text= t('authActiveDirectoryLdaps.hero.titleHighlight')
    p(class="text-xl text-gray-600 max-w-3xl")
      = t('authActiveDirectoryLdaps.hero.subtitle')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectoryLdaps.overview.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-0")
        != t('authActiveDirectoryLdaps.overview.description')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectoryLdaps.config.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('authActiveDirectoryLdaps.config.description')
      .code-block
        .code-header
          span= t('authActiveDirectoryLdaps.config.codeHeader.label')
          span= t('authActiveDirectoryLdaps.config.codeHeader.context')
        .code-content
          pre.
            AD_LDAP_ENABLED=true
            AD_LDAP_URL=ldaps://dc.example.com:636
            AD_LDAP_BASE_DN=DC=example,DC=com
            AD_LDAP_BIND_DN=CN=svc-ldap,CN=Users,DC=example,DC=com
            AD_LDAP_BIND_PASSWORD=your-service-account-password
            AD_LDAP_TLS_REJECT_UNAUTHORIZED=true
            AD_LDAP_DEFAULT_ROLES=user

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authActiveDirectoryLdaps.related.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      .flex.flex-wrap.gap-3
        a(href=wikiPath('/auth/active-directory') class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-indigo-200 text-indigo-700 text-sm font-medium hover:bg-indigo-50")
          = t('authActiveDirectoryLdaps.related.hub')
        a(href=wikiPath('/auth/active-directory/ldap') class="inline-flex items-center gap-1 px-4 py-2 rounded-lg border border-indigo-200 text-indigo-700 text-sm font-medium hover:bg-indigo-50")
          = t('authActiveDirectoryLdaps.related.ldap')
