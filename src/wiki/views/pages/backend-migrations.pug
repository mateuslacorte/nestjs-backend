extends ../layouts/main

block content
  .mb-12
    .inline-flex.items-center.gap-2.px-3.py-1.bg-indigo-50.rounded-full.text-indigo-700.text-sm.font-medium.mb-4
      svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4")
      span= t('backendMigrations.badge')
    h1(class="text-4xl font-bold text-gray-900 mb-4")
      | #{t('backendMigrations.hero.titlePrefix')} 
      span.gradient-text= t('backendMigrations.hero.titleHighlight')
    p(class="text-xl text-gray-600 max-w-3xl")
      = t('backendMigrations.hero.subtitle')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('backendMigrations.overview.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('backendMigrations.overview.description')
      ul.space-y-2.text-gray-700
        each item in tm('backendMigrations.overview.items')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('backendMigrations.config.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('backendMigrations.config.description')
      h3(class="font-semibold text-gray-900 mb-3")= t('backendMigrations.config.envTitle')
      ul.space-y-2.text-gray-700.mb-6
        each item in tm('backendMigrations.config.envItems')
          li • #{item}
      .code-block
        .code-header
          span= t('backendMigrations.config.codeHeader.label')
          span= t('backendMigrations.config.codeHeader.context')
        .code-content
          pre.
            POSTGRES_SYNCHRONIZE=false
            POSTGRES_MIGRATIONS_RUN=true

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('backendMigrations.bootCli.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('backendMigrations.bootCli.description')
      ul.space-y-2.text-gray-700
        each item in tm('backendMigrations.bootCli.scripts')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('backendMigrations.workflow.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        = t('backendMigrations.workflow.description')
      ol.list-decimal.list-inside.space-y-2.text-gray-700
        each item in tm('backendMigrations.workflow.steps')
          li= item

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('backendMigrations.docker.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700")
        != t('backendMigrations.docker.description')
