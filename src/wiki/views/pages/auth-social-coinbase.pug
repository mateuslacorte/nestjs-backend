extends ../layouts/main

block content
  .mb-12
    .inline-flex.items-center.gap-2.px-3.py-1.bg-indigo-50.rounded-full.text-indigo-700.text-sm.font-medium.mb-4
      svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
      span= t('authSocialCoinbase.badge')
    h1(class="text-4xl font-bold text-gray-900 mb-4")
      | #{t('authSocialCoinbase.hero.titlePrefix')} 
      span.gradient-text= t('authSocialCoinbase.hero.titleHighlight')
    p(class="text-xl text-gray-600 max-w-3xl")
      = t('authSocialCoinbase.hero.subtitle')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.overview.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('authSocialCoinbase.overview.description')
      ul.space-y-2.text-gray-700
        each item in tm('authSocialCoinbase.overview.items')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.console.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('authSocialCoinbase.console.description')
      ol(class="list-decimal list-inside space-y-2 text-gray-700")
        each item in tm('authSocialCoinbase.console.steps')
          li= item

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.env.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('authSocialCoinbase.env.description')
      .code-block
        .code-header
          span= t('authSocialCoinbase.env.codeHeader.label')
          span= t('authSocialCoinbase.env.codeHeader.context')
        .code-content
          pre.
            COINBASE_AUTH_ENABLED=true
            COINBASE_CLIENT_ID=your-coinbase-client-id
            COINBASE_CLIENT_SECRET=your-coinbase-client-secret
            COINBASE_CALLBACK_URL=http://localhost:3000/api/v1/auth/coinbase/callback
            COINBASE_REDIRECT_ALLOWLIST=myapp://success,http://localhost:5173/auth/callback
            COINBASE_OAUTH_DEFAULT_ROLES=

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.roles.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700")
        != t('authSocialCoinbase.roles.description')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.flow.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      ol(class="list-decimal list-inside space-y-2 text-gray-700")
        each item in tm('authSocialCoinbase.flow.items')
          li= item

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.api.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8.space-y-8
      div
        h3(class="font-semibold text-gray-900 mb-2")= t('authSocialCoinbase.api.start.title')
        p(class="text-gray-700 mb-3")
          != t('authSocialCoinbase.api.start.description')
        .code-block.mb-2
          .code-header
            span= t('authSocialCoinbase.api.start.codeHeader.label')
            span= t('authSocialCoinbase.api.start.codeHeader.context')
          .code-content
            pre.
              GET #{apiBasePath}/auth/coinbase?redirect=http%3A%2F%2Flocalhost%3A5173%2Fauth%2Fcallback
        p(class="text-sm text-gray-500")= t('authSocialCoinbase.api.start.errors')

      div
        h3(class="font-semibold text-gray-900 mb-2")= t('authSocialCoinbase.api.callback.title')
        p(class="text-gray-700 mb-3")
          != t('authSocialCoinbase.api.callback.description')
        .code-block
          .code-header
            span= t('authSocialCoinbase.api.callback.codeHeader.label')
            span= t('authSocialCoinbase.api.callback.codeHeader.context')
          .code-content
            pre.
              GET #{apiBasePath}/auth/coinbase/callback?code=COINBASE_AUTH_CODE&state=...
              → 302 Location: http://localhost:5173/auth/callback?code=EXCHANGE_CODE

      div
        h3(class="font-semibold text-gray-900 mb-2")= t('authSocialCoinbase.api.exchange.title')
        p(class="text-gray-700 mb-3")
          != t('authSocialCoinbase.api.exchange.description')
        .code-block.mb-4
          .code-header
            span= t('authSocialCoinbase.api.exchange.requestHeader.label')
            span= t('authSocialCoinbase.api.exchange.requestHeader.context')
          .code-content
            pre.
              POST #{apiBasePath}/auth/exchange
              Content-Type: application/json

              {
                "code": "EXCHANGE_CODE"
              }
        .code-block.mb-2
          .code-header
            span= t('authSocialCoinbase.api.exchange.responseHeader.label')
            span= t('authSocialCoinbase.api.exchange.responseHeader.context')
          .code-content
            pre.
              {
                "user": {
                  "id": "...",
                  "email": "user@example.com",
                  "firstName": "Jane",
                  "lastName": "Doe",
                  "roles": [],
                  "coinbaseId": "9da7b200-061d-49d4-b866-29399cfc8cd0",
                  "isActive": true
                },
                "accessToken": "eyJhbGciOiJIUzI1NiIs...",
                "refreshToken": "eyJhbGciOiJIUzI1NiIs..."
              }
        p(class="text-sm text-gray-500")= t('authSocialCoinbase.api.exchange.errors')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.web.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('authSocialCoinbase.web.description')
      .code-block.mb-6
        .code-header
          span= t('authSocialCoinbase.web.startHeader.label')
          span= t('authSocialCoinbase.web.startHeader.context')
        .code-content
          pre.
            const API = 'http://localhost:3000/api/v1';
            const redirect = encodeURIComponent(
              'http://localhost:5173/auth/callback'
            );

            #{t('authSocialCoinbase.samples.fullPageRedirect')}
            window.location.href = `${API}/auth/coinbase?redirect=${redirect}`;
      .code-block.mb-6
        .code-header
          span= t('authSocialCoinbase.web.callbackHeader.label')
          span= t('authSocialCoinbase.web.callbackHeader.context')
        .code-content
          pre.
            #{t('authSocialCoinbase.samples.spaCallback')}
            const params = new URLSearchParams(window.location.search);
            const code = params.get('code');
            if (!code) throw new Error('Missing exchange code');

            const res = await fetch('http://localhost:3000/api/v1/auth/exchange', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ code }),
            });
            if (!res.ok) throw new Error(await res.text());

            const { user, accessToken, refreshToken } = await res.json();
            #{t('authSocialCoinbase.samples.persistTokens')}
            sessionStorage.setItem('accessToken', accessToken);
            console.log('signed in', user.email);
      ul.space-y-2.text-gray-700
        each item in tm('authSocialCoinbase.web.notes')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.mobile.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('authSocialCoinbase.mobile.description')
      .code-block.mb-6
        .code-header
          span= t('authSocialCoinbase.mobile.openHeader.label')
          span= t('authSocialCoinbase.mobile.openHeader.context')
        .code-content
          pre.
            import * as Linking from 'expo-linking';
            import * as WebBrowser from 'expo-web-browser';

            const API = 'https://api.example.com/api/v1';
            const redirect = encodeURIComponent('myapp://success');

            async function signInWithCoinbase() {
              const url = `${API}/auth/coinbase?redirect=${redirect}`;
              await WebBrowser.openAuthSessionAsync(url, 'myapp://success');
            }
      .code-block.mb-6
        .code-header
          span= t('authSocialCoinbase.mobile.handleHeader.label')
          span= t('authSocialCoinbase.mobile.handleHeader.context')
        .code-content
          pre.
            import * as Linking from 'expo-linking';

            async function exchangeFromUrl(url) {
              const { queryParams } = Linking.parse(url);
              const code = queryParams?.code;
              if (!code) return;

              const res = await fetch(`${API}/auth/exchange`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code }),
              });
              const data = await res.json();
              #{t('authSocialCoinbase.samples.tokenFields')}
              return data;
            }

            Linking.addEventListener('url', ({ url }) => {
              exchangeFromUrl(url);
            });
      ul.space-y-2.text-gray-700
        each item in tm('authSocialCoinbase.mobile.notes')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.security.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      ul.space-y-2.text-gray-700
        each item in tm('authSocialCoinbase.security.items')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.userModel.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")= t('authSocialCoinbase.userModel.description')
      ul.space-y-2.text-gray-700
        each item in tm('authSocialCoinbase.userModel.items')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('authSocialCoinbase.related.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      ul.space-y-3
        li
          a(href=wikiPath('/auth/social') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.social')
