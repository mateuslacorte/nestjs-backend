        li
          a(href=wikiPath('/auth/social/twitter') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.twitter')
        li
          a(href=wikiPath('/auth/social/github') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.github')
        li
          a(href=wikiPath('/auth/social/figma') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.figma')
        li
          a(href=wikiPath('/auth/social/linkedin') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.linkedin')
        li
          a(href=wikiPath('/auth/social/slack') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.slack')
        li
          a(href=wikiPath('/auth/social/atlassian') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.atlassian')
        li
          a(href=wikiPath('/auth/social/gitlab') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.gitlab')
        li
          a(href=wikiPath('/auth/social/bitbucket') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.bitbucket')
        li
          a(href=wikiPath('/auth/social/discord') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.discord')
        li
          a(href=wikiPath('/auth/social/twitch') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.twitch')
        li
          a(href=wikiPath('/auth/social/steam') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.steam')
        li
        li
          a(href=wikiPath('/auth/social/amazon') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.amazon')
        li
          a(href=wikiPath('/auth/social/microsoft') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.microsoft')
        li
          a(href=wikiPath('/auth/social/patreon') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.patreon')
        li
          a(href=wikiPath('/auth/social/dropbox') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.dropbox')
        li
          a(href=wikiPath('/auth/social/metamask') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.metamask')
        li
          a(href=wikiPath('/auth/social/apple') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.apple')
        li
          a(href=wikiPath('/auth/social/reddit') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.reddit')
        li
          a(href=wikiPath('/auth') class="text-indigo-600 hover:underline font-medium")= t('authSocialCoinbase.related.auth')
