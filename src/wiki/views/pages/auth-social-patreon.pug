        li
          a(href=wikiPath('/auth/social/twitter') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.twitter')
        li
          a(href=wikiPath('/auth/social/github') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.github')
        li
          a(href=wikiPath('/auth/social/figma') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.figma')
        li
          a(href=wikiPath('/auth/social/linkedin') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.linkedin')
        li
          a(href=wikiPath('/auth/social/slack') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.slack')
        li
          a(href=wikiPath('/auth/social/atlassian') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.atlassian')
        li
          a(href=wikiPath('/auth/social/gitlab') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.gitlab')
        li
          a(href=wikiPath('/auth/social/bitbucket') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.bitbucket')
        li
          a(href=wikiPath('/auth/social/discord') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.discord')
        li
          a(href=wikiPath('/auth/social/twitch') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.twitch')
        li
          a(href=wikiPath('/auth/social/steam') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.steam')
        li
        li
          a(href=wikiPath('/auth/social/amazon') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.amazon')
        li
          a(href=wikiPath('/auth/social/microsoft') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.microsoft')
        li
          a(href=wikiPath('/auth/social/dropbox') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.dropbox')
        li
          a(href=wikiPath('/auth/social/coinbase') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.coinbase')
        li
          a(href=wikiPath('/auth/social/metamask') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.metamask')
        li
          a(href=wikiPath('/auth/social/apple') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.apple')
        li
          a(href=wikiPath('/auth/social/reddit') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.reddit')
        li
          a(href=wikiPath('/auth') class="text-indigo-600 hover:underline font-medium")= t('authSocialPatreon.related.auth')
