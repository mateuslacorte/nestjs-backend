extends ../layouts/main

block content
  .mb-12
    .inline-flex.items-center.gap-2.px-3.py-1.bg-indigo-50.rounded-full.text-indigo-700.text-sm.font-medium.mb-4
      svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
      span= t('securityAudit.badge')
    h1(class="text-4xl font-bold text-gray-900 mb-4")
      | #{t('securityAudit.hero.titlePrefix')} 
      span.gradient-text= t('securityAudit.hero.titleHighlight')
    p(class="text-xl text-gray-600 max-w-3xl")
      = t('securityAudit.hero.subtitle')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('securityAudit.overview.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-6")
        != t('securityAudit.overview.description')
      ul.space-y-2.text-gray-700
        each item in tm('securityAudit.overview.items')
          li • #{item}

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('securityAudit.decorator.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('securityAudit.decorator.description')
      h3(class="font-semibold text-gray-900 mb-3")= t('securityAudit.decorator.optionsTitle')
      ul.space-y-2.text-gray-700.mb-6
        each item in tm('securityAudit.decorator.options')
          li • #{item}
      .code-block
        .code-header
          span= t('securityAudit.decorator.codeHeader.label')
          span= t('securityAudit.decorator.codeHeader.context')
        .code-content
          pre.
            import { Audit } from '@common/audit/decorators/audit.decorator';

            @Public()
            @Audit({
              action: 'auth.login',
              category: 'auth',
              description: 'Email/password login attempt',
              identifierFrom: 'email',
              userIdFrom: 'user.id',
            })
            @Post('login')
            async login(@Body() dto: LoginDto) {
              return this.authService.login(dto);
            }

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('securityAudit.userid.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700")
        != t('securityAudit.userid.description')

  section.mb-12
    h2(class="text-2xl font-bold text-gray-900 mb-6")= t('securityAudit.api.title')
    .bg-white.rounded-xl.border.border-gray-200.p-8
      p(class="text-gray-700 mb-4")
        != t('securityAudit.api.description')
      ul.space-y-2.text-gray-700.mb-6
        each item in tm('securityAudit.api.endpoints')
          li • #{item}

      .code-block.mb-6
        .code-header
          span= t('securityAudit.api.listRequest.codeHeader.label')
          span= t('securityAudit.api.listRequest.codeHeader.context')
        .code-content
          pre.
            GET #{apiBasePath}/audit?q=auth.login&amp;limit=50
            Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

      .code-block
        .code-header
          span= t('securityAudit.api.listResponse.codeHeader.label')
          span= t('securityAudit.api.listResponse.codeHeader.context')
        .code-content
          pre.
            {
              "items": [
                {
                  "id": "uuid-...",
                  "action": "auth.login",
                  "category": "auth",
                  "ip": "203.0.113.10",
                  "port": 443,
                  "success": true,
                  "identifier": "user@example.com",
                  "userId": "uuid-...",
                  "timestamp": "2026-08-10T12:00:00.000Z"
                }
              ],
              "nextCursor": "eyJjIjoiMjAyNi0..."
            }
