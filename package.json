{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API with NestJS",
  "license": "GPL-3.0-only",
  "main": "src/main.ts",
  "scripts": {
    "start": "rm -rf dist && rm -f tsconfig.tsbuildinfo && nest start",
    "start:dev": "rm -rf dist && rm -f tsconfig.tsbuildinfo && nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint . --ext .ts --fix",
    "prettier": "prettier --write .",
    "prepare": "husky",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/MigrationName -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts"
  },
  "overrides": {
    "mailparser": "^3.9.14",
    "preview-email": {
      "uuid": "^11.1.1"
    },
    "@nestjs/graphql": {
      "ws": "^8.21.1"
    },
    "graphql-ws": {
      "ws": "^8.21.1"
    },
    "@fastify/static": "^10.1.3",
    "find-my-way": "^9.7.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
