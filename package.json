    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "js-yaml@5": "5.2.3",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "undici": "^6.28.0",
    "glob": "^13.0.6",
    "encoding-sniffer": "^1.0.2",
    "cheerio": "^1.2.0",
    "js-beautify": "^2.0.3",
    "test-exclude": "^8.0.0",
    "babel-plugin-istanbul": "^8.0.2",
    "subscriptions-transport-ws": "https://registry.npmjs.org/subscriptions-transport-ws/-/subscriptions-transport-ws-0.11.0.tgz"
