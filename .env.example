# Comma-separated Role values for new Dropbox users (e.g. user or user,manager). Empty = []
DROPBOX_OAUTH_DEFAULT_ROLES=

# MetaMask SIWE (optional — Sign-In with Ethereum / EIP-4361)
METAMASK_AUTH_ENABLED=false
METAMASK_DOMAIN=localhost
METAMASK_URI=http://localhost:3000
METAMASK_STATEMENT=Sign in to the NestJS Boilerplate
# Comma-separated allowed chain IDs (default: 1 = Ethereum mainnet)
METAMASK_CHAIN_IDS=1
# Nonce TTL in Redis (seconds)
METAMASK_NONCE_TTL_SECONDS=300
# Comma-separated Role values for new MetaMask users (e.g. user or user,manager). Empty = []
METAMASK_OAUTH_DEFAULT_ROLES=

# Active Directory LDAP/LDAPS (optional — on-prem AD DS bind login)
AD_LDAP_ENABLED=false
# ldap://dc.example.com:389 or ldaps://dc.example.com:636
AD_LDAP_URL=
AD_LDAP_BASE_DN=DC=example,DC=com
AD_LDAP_BIND_DN=CN=svc-ldap,CN=Users,DC=example,DC=com
AD_LDAP_BIND_PASSWORD=
# Default: (|(sAMAccountName={{username}})(userPrincipalName={{username}}))
AD_LDAP_USER_FILTER=
# Set false only for dev/self-signed LDAPS certificates
AD_LDAP_TLS_REJECT_UNAUTHORIZED=true
AD_LDAP_CONNECT_TIMEOUT_MS=5000
# Comma-separated Role values used when GROUP_ROLE_MAP is empty, or no group matches (e.g. user or user,manager)
AD_LDAP_DEFAULT_ROLES=
# Map AD security groups (memberOf / GPO) → app roles. Format: groupDnOrCn|role;groupDnOrCn|role
# Example: CN=Nest-Admins,OU=Groups,DC=example,DC=com|admin;Nest-Managers|manager;Nest-Users|user
AD_LDAP_GROUP_ROLE_MAP=
# When true (default), refresh user.roles from AD groups on every AD login (requires GROUP_ROLE_MAP)
AD_LDAP_SYNC_ROLES_ON_LOGIN=true

# Apple Sign In (optional — Authorization Code + form_post callback, not standard OAuth2)
APPLE_AUTH_ENABLED=false
# Services ID created in Apple Developer → Identifiers (e.g. com.example.service)
APPLE_CLIENT_ID=
# 10-character Team ID from Apple Developer account
APPLE_TEAM_ID=
# Key ID from Apple Developer → Keys (Sign in with Apple)
APPLE_KEY_ID=
# Contents of the .p8 private key file. Use literal \n between lines (Docker-safe)
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
APPLE_REDIRECT_ALLOWLIST=myapp://success,http://localhost:5173/auth/callback
# Comma-separated Role values for new Apple users (e.g. user or user,manager). Empty = []
APPLE_OAUTH_DEFAULT_ROLES=

# Session secret for OAuth PKCE (X/Twitter). Falls back to JWT_SECRET if unset.
SESSION_SECRET=
# Set Secure on session cookies. Use false for plain HTTP (localhost / Docker).
COOKIE_SECURE=false

# MinIO API Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bucket-name

# Graylog (usado pelo docker-compose)
# GRAYLOG_PASSWORD_SECRET: mínimo 16 caracteres
GRAYLOG_PASSWORD_SECRET=changemechangemechangeme
# SHA-256 da senha do usuário admin (o valor abaixo corresponde a "admin")
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918