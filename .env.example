# Steam OpenID 2.0 (optional — Authorization Code Exchange via OpenID, not OAuth2)
STEAM_AUTH_ENABLED=false
# Optional Steam Web API key for GetPlayerSummaries (persona name). OpenID works without it.
STEAM_API_KEY=
STEAM_CALLBACK_URL=http://localhost:3000/api/v1/auth/steam/callback
# Realm must match the site origin of STEAM_CALLBACK_URL (trailing slash recommended)
STEAM_REALM=http://localhost:3000/
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
STEAM_REDIRECT_ALLOWLIST=myapp://success,http://localhost:5173/auth/callback
# Comma-separated Role values for new Steam users (e.g. user or user,manager). Empty = []
STEAM_OAUTH_DEFAULT_ROLES=

