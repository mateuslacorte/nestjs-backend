AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CALLBACK_URL=http://localhost:3000/api/v1/auth/amazon/callback
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
