PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CALLBACK_URL=http://localhost:3000/api/v1/auth/patreon/callback
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
