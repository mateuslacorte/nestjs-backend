REDDIT_CALLBACK_URL=http://localhost:3000/api/v1/auth/reddit/callback
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
REDDIT_REDIRECT_ALLOWLIST=myapp://success,http://localhost:5173/auth/callback
# Comma-separated Role values for new Reddit users (e.g. user or user,manager). Empty = []
REDDIT_OAUTH_DEFAULT_ROLES=

