# Dropbox OAuth2 (optional — Authorization Code Exchange)
DROPBOX_AUTH_ENABLED=false
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_CALLBACK_URL=http://localhost:3000/api/v1/auth/dropbox/callback
# Comma-separated allowed redirect URL prefixes (mobile deep link and/or web)
